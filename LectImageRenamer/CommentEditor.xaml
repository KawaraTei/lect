<UserControl x:Class="LectImageRenamer.CommentEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="6">
        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding CommentDocument.CanEdit}"
                 AutomationProperties.Name="コメント"
                 ToolTip="コメント（自動保存）"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Height="66" Padding="4" FontSize="12" VerticalContentAlignment="Top"
                 Background="#1F2530" Foreground="#F3F4F6" CaretBrush="#F3F4F6"
                 BorderBrush="#536174" SelectionBrush="#5EA1FF" />
        <TextBlock Text="{Binding CommentDocument.Status}" FontSize="11" Margin="0,4,0,0"
                   Foreground="#AEB7C5" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding CommentDocument.Status}" />
    </StackPanel>
</UserControl>
