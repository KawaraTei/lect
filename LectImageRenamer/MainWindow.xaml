<Window x:Class="LectImageRenamer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LectImageRenamer"
        mc:Ignorable="d"
        Title="画像リネーム" Height="720" Width="1120"
        Icon="Assets/AppIcon.ico"
        MinHeight="560" MinWidth="860"
        AllowDrop="True"
        Drop="ImageList_Drop"
        DragOver="ImageList_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#101318" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#171B22" />
        <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#1F2530" />
        <SolidColorBrush x:Key="SurfaceAltBackgroundBrush" Color="#242B36" />
        <SolidColorBrush x:Key="BorderBrush" Color="#374151" />
        <SolidColorBrush x:Key="MutedBorderBrush" Color="#2F3744" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F4F6" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AEB7C5" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5EA1FF" />
        <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />

        <Style x:Key="ToolbarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceAltBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="DangerButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Style>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource SurfaceBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style x:Key="ImageListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Container"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Container" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Container" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Container" Property="Background" Value="#263B56" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="GridImageTemplate">
          <StackPanel Width="{Binding DataContext.GridItemSize, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}">
            <Border Width="{Binding DataContext.GridItemSize, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                    Height="{Binding DataContext.GridItemSize, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                    BorderBrush="{StaticResource MutedBorderBrush}"
                    BorderThickness="1"
                    Background="{StaticResource SurfaceBackgroundBrush}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Image Source="{Binding Thumbnail}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Border VerticalAlignment="Bottom"
                            Background="#D9101318"
                            Padding="6,4">
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="{Binding DisplayIndex}"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="{Binding FileName}"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
            <local:CommentEditor Visibility="{Binding DataContext.IsCommentMode, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ListImageTemplate">
            <Border BorderBrush="{StaticResource MutedBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Background="{StaticResource SurfaceBackgroundBrush}"
                    Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding DisplayIndex}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <Border Grid.Column="1"
                            Width="72"
                            Height="54"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Background="{StaticResource PanelBackgroundBrush}">
                        <Image Source="{Binding Thumbnail}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="2"
                                Margin="12,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding FullPath}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="3"
                               Text="{Binding Extension}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            IsEnabled="{Binding CanChooseLayout}"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <RadioButton Content="グリッド"
                                 IsChecked="{Binding IsGridView, Mode=TwoWay}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,12,0" />
                    <RadioButton Content="リスト"
                                 IsChecked="{Binding IsGridView, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=TwoWay}"
                                 VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="28,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="サイズ"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <Slider Width="180"
                            Minimum="96"
                            Maximum="260"
                            TickFrequency="16"
                            IsSnapToTickEnabled="False"
                            Value="{Binding GridItemSize}" />
                </StackPanel>

                <ToggleButton Grid.Column="2" Content="コメントモード"
                              IsChecked="{Binding IsCommentMode, Mode=TwoWay}"
                              HorizontalAlignment="Left" Margin="24,0,0,0" Padding="12,6"
                              AutomationProperties.Name="コメントモード">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ModeBorder" Background="{StaticResource SurfaceAltBackgroundBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ModeBorder" Property="Background" Value="#263B56" />
                                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <TextBlock Grid.Column="3"
                           Text="{Binding DropHint}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="28,0" />

                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,10,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="名前"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox Width="220"
                             Height="32"
                             VerticalContentAlignment="Center"
                             Text="{Binding RenamePrefix, UpdateSourceTrigger=PropertyChanged}"
                             ToolTipService.ShowDuration="30000">
                        <TextBox.ToolTip>
                            <ToolTip>
                                <TextBlock Foreground="#101318"><Run Text="通常の名前指定: image → image_001.png" /><LineBreak />
                                    <Run Text="{}{}: 元のファイル名（拡張子を除く）" /><LineBreak />
                                    <Run Text="\n: 連番。nの数がゼロ埋めの桁数（\nnn → 001）" /><LineBreak />
                                    <Run Text="番号は「開始」から、一覧の順に付けます。" /><LineBreak />
                                    <Run Text="例（元の名前: photo.png、開始: 1）" /><LineBreak />
                                    <Run Text="\nnn{} → 001photo.png" /><LineBreak />
                                    <Run Text="{}{}_\nnn → photo_001.png" /><LineBreak />
                                    <Run Text="書式指定時は区切り文字も入力します。拡張子は維持します。" />
                                </TextBlock>
                            </ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>
                    <TextBlock Text="開始"
                               VerticalAlignment="Center"
                               Margin="12,0,8,0" />
                    <TextBox Width="56"
                             Height="32"
                             HorizontalContentAlignment="Right"
                             VerticalContentAlignment="Center"
                             Text="{Binding RenameStartNumber, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="連番リネーム"
                            Command="{Binding RenameCommand}"
                            Style="{StaticResource ToolbarButtonStyle}" />
                    <Button Content="クリア"
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource ToolbarButtonStyle}" />
                    <Button Content="削除"
                            Command="{Binding DeleteSelectedCommand}"
                            Style="{StaticResource DangerButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="12">
            <Border BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    Background="{StaticResource SurfaceBackgroundBrush}"
                    Visibility="{Binding HasNoImages, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="画像をここへドラッグアンドドロップ"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="PNG / JPG / BMP / GIF / TIFF に対応。フォルダーを落とした場合は中の画像も読み込みます。"
                               Margin="0,10,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <ListBox x:Name="GridImageList"
                     ItemsSource="{Binding Images}"
                     ItemTemplate="{StaticResource GridImageTemplate}"
                     ItemContainerStyle="{StaticResource ImageListBoxItemStyle}"
                     SelectionMode="Extended"
                     AllowDrop="True"
                     Background="{StaticResource SurfaceBackgroundBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="{Binding ShowGrid, Converter={StaticResource BooleanToVisibilityConverter}}"
                     SelectionChanged="ImageList_SelectionChanged"
                     PreviewMouseLeftButtonDown="ImageList_PreviewMouseLeftButtonDown"
                     PreviewMouseLeftButtonUp="ImageList_PreviewMouseLeftButtonUp"
                     PreviewMouseMove="ImageList_PreviewMouseMove"
                     DragOver="ImageList_DragOver"
                     Drop="ImageList_Drop">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <ListBox x:Name="ListImageList"
                     ItemsSource="{Binding Images}"
                     ItemTemplate="{StaticResource ListImageTemplate}"
                     ItemContainerStyle="{StaticResource ImageListBoxItemStyle}"
                     SelectionMode="Extended"
                     AllowDrop="True"
                     Background="{StaticResource SurfaceBackgroundBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1"
                     Visibility="{Binding ShowGrid, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                     SelectionChanged="ImageList_SelectionChanged"
                     PreviewMouseLeftButtonDown="ImageList_PreviewMouseLeftButtonDown"
                     PreviewMouseLeftButtonUp="ImageList_PreviewMouseLeftButtonUp"
                     PreviewMouseMove="ImageList_PreviewMouseMove"
                     DragOver="ImageList_DragOver"
                     Drop="ImageList_Drop" />
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </Border>
    </Grid>
</Window>
