<Window x:Class="LectImageRenamer.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LectImageRenamer"
        Title="プレビュー"
        Icon="Assets/AppIcon.ico"
        Height="640"
        Width="900"
        MinHeight="300"
        MinWidth="420">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Background="#101318">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image Grid.Row="0"
               Source="{Binding PreviewImage}"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <Border Grid.Row="1"
                Background="#171B22"
                BorderBrush="#374151"
                BorderThickness="0,1,0,0"
                Padding="10,8">
            <DockPanel>
                <CheckBox DockPanel.Dock="Right" Content="コメントモード" Margin="12,0,0,0"
                          Foreground="#F3F4F6" IsChecked="{Binding IsCommentMode, Mode=TwoWay}" />
                <TextBlock Text="{Binding PreviewPath}"
                       TextTrimming="CharacterEllipsis"
                       Foreground="#AEB7C5" />
            </DockPanel>
        </Border>
        <local:CommentEditor Grid.Row="2" DataContext="{Binding CurrentImage}"
                             Visibility="{Binding IsCommentMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <local:CommentEditor.Style>
                <Style TargetType="local:CommentEditor">
                    <Setter Property="IsEnabled" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </local:CommentEditor.Style>
        </local:CommentEditor>
    </Grid>
</Window>
